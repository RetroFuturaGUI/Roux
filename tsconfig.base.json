{
    "compilerOptions":
    {
        "target": "ES2022",
        "lib": ["ES2023"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "strict": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "forceConsistentCasingInFileNames": true,
        "composite": true,
        "declaration": true,
        "sourceMap": true,
        "skipLibCheck": true
    }
}
